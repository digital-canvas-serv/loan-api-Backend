generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")

}

enum Role {
  USER
  ADMIN
  SUPER_ADMIN
}

enum AccountStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
  BLOCKED
}

enum LoanStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  DOCUMENTS_REQUIRED
  COLLATERAL_VERIFICATION
  PENDING
  APPROVED
  REJECTED
  DISBURSED
  ACTIVE
  OVERDUE
  CLOSED
  CANCELLED
  PAID
  DEFAULTED
}

enum RepaymentPreference {
  MONTHLY
  BIWEEKLY
  QUARTERLY
  BULLET
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REVERSED
  REFUNDED
}

enum PaymentMethod {
  BANK_TRANSFER
  CARD
  CASH
  WALLET
  OTHER
}

model LoanProduct {
  id             String   @id @default(cuid())
  name           String   @unique
  description    String?
  minAmount     Decimal  @db.Decimal(12, 2)
  maxAmount     Decimal  @db.Decimal(12, 2)
  minTermMonths Int
  maxTermMonths Int
  baseRate      Decimal  @db.Decimal(5, 2)
  originationFeeRate Decimal @default(0) @db.Decimal(5, 2)
  lateFeeAmount Decimal @default(0) @db.Decimal(12, 2)
  gracePeriodDays Int @default(0)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  loans         Loan[]
}

enum LegacyLoanStatus {
  ACTIVE
  PAID
  DEFAULTED
}

enum CollateralStatus {
  PENDING
  VERIFIED
  PLEDGED
  RELEASED
  REJECTED
}

enum KycDocumentStatus {
  PENDING
  UNDER_REVIEW
  VERIFIED
  REJECTED
  REQUIRES_UPDATE
}

model User {
  id           String       @id @default(cuid())
  name         String
  email        String       @unique
  passwordHash String
  role         Role         @default(USER)
  status       AccountStatus @default(PENDING)
  reviewNote   String?
  dateOfBirth  DateTime?
  phone        String?
  address      String?
  city         String?
  state        String?
  postalCode   String?
  occupation   String?
  businessInfo String?
  profilePhoto String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  collaterals  Collateral[]
  loans        Loan[]
  repayments   Repayment[]
  documents    ProfileDocument[]
  uploadedDocuments ProfileDocument[] @relation("UploadedDocuments")
  verifiedDocuments ProfileDocument[] @relation("VerifiedDocuments")
  auditLogs AuditLog[] @relation("AuditActor")
  payments Payment[]
  recordedPayments Payment[] @relation("PaymentRecorder")
  notifications Notification[]
  loanDocuments LoanDocument[]
  collateralVerifications CollateralVerification[] @relation("CollateralVerifiers")
}

model DocumentType {
  id          String            @id @default(cuid())
  name        String            @unique
  description String?
  required    Boolean           @default(true)
  active      Boolean           @default(true)
  createdAt   DateTime          @default(now())
  documents   ProfileDocument[]
}

model ProfileDocument {
  id              String             @id @default(cuid())
  userId          String
  collateralId    String?
  loanId          String?
  documentTypeId  String?
  uploadedBy      String?
  verifiedBy      String?
  filename        String
  mimeType        String
  size            Int
  content         Bytes              @db.ByteA
  status          KycDocumentStatus  @default(PENDING)
  rejectionReason String?
  uploadedAt      DateTime           @default(now())
  verifiedAt      DateTime?
  createdAt       DateTime           @default(now())
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  collateral      Collateral?        @relation(fields: [collateralId], references: [id], onDelete: Cascade)
  loan            Loan?              @relation(fields: [loanId], references: [id], onDelete: Cascade)
  type            DocumentType?      @relation(fields: [documentTypeId], references: [id], onDelete: SetNull)
  uploader        User?              @relation("UploadedDocuments", fields: [uploadedBy], references: [id])
  verifier        User?              @relation("VerifiedDocuments", fields: [verifiedBy], references: [id])

  @@index([userId, status])
  @@index([documentTypeId])
}

// Named domain contract for future KYC-specific document migrations.
model KycDocument {
  id              String            @id @default(cuid())
  userId          String
  documentTypeId  String?
  status          KycDocumentStatus @default(PENDING)
  rejectionReason String?
  uploadedBy      String?
  verifiedBy      String?
  uploadedAt      DateTime          @default(now())
  verifiedAt      DateTime?
  filename        String
  mimeType        String
  size            Int
  content         Bytes             @db.ByteA

  @@index([userId, status])
}

model Collateral {
  id          String           @id @default(cuid())
  userId      String
  type        String
  itemName    String?
  description String
  quantity    Decimal?         @db.Decimal(12, 3)
  weight      Decimal?         @db.Decimal(12, 3)
  value       Decimal          @db.Decimal(12, 2)
  declaredValue Decimal?       @db.Decimal(12, 2)
  ownershipInformation String?
  documentUrl String?
  status      CollateralStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  loans       Loan[]
  documents   ProfileDocument[]
  verifications CollateralVerification[]
}

model Loan {
  id           String     @id @default(cuid())
  userId       String
  collateralId String
  loanProductId String?
  amount       Decimal    @db.Decimal(12, 2)
  requestedAmount Decimal? @db.Decimal(12, 2)
  approvedAmount Decimal? @db.Decimal(12, 2)
  interestRate Decimal    @db.Decimal(5, 2)
  termMonths   Int
  requestedTenureMonths Int?
  approvedTenureMonths Int?
  repaymentPreference RepaymentPreference?
  reviewNote   String?
  monthlyPayment Decimal? @db.Decimal(12, 2)
  totalPayable Decimal? @db.Decimal(12, 2)
  principalAmount Decimal? @db.Decimal(12, 2)
  feesAmount Decimal? @db.Decimal(12, 2)
  startDate DateTime?
  status       LoanStatus @default(PENDING)
  purpose      String
  dueDate      DateTime?
  approvedAt   DateTime?
  disbursedAt  DateTime?
  closedAt     DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  collateral   Collateral @relation(fields: [collateralId], references: [id])
  product      LoanProduct? @relation(fields: [loanProductId], references: [id], onDelete: SetNull)
  repayments   Repayment[]
  payments     Payment[]
  schedules    RepaymentSchedule[]
  documents    ProfileDocument[]
  loanDocuments LoanDocument[]
}

model CollateralVerification {
  id           String   @id @default(cuid())
  collateralId String
  verifiedBy   String
  status       CollateralStatus
  notes        String?
  createdAt    DateTime @default(now())
  collateral   Collateral @relation(fields: [collateralId], references: [id], onDelete: Cascade)
  verifier     User @relation("CollateralVerifiers", fields: [verifiedBy], references: [id])
}

model LoanDocument {
  id          String        @id @default(cuid())
  loanId      String
  userId      String
  uploadedBy  String?
  filename    String
  mimeType    String
  size        Int
  content     Bytes         @db.ByteA
  status      KycDocumentStatus @default(PENDING)
  rejectionReason String?
  uploadedAt  DateTime      @default(now())
  verifiedBy  String?
  verifiedAt  DateTime?
  loan        Loan          @relation(fields: [loanId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([loanId, status])
}

model Repayment {
  id        String   @id @default(cuid())
  userId    String
  loanId    String
  amount    Decimal  @db.Decimal(12, 2)
  paidAt    DateTime @default(now())
  reference String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  loan      Loan     @relation(fields: [loanId], references: [id], onDelete: Cascade)
}

model RepaymentSchedule {
  id            String   @id @default(cuid())
  loanId        String
  installmentNo Int
  dueDate       DateTime
  principalDue  Decimal  @db.Decimal(12, 2)
  interestDue   Decimal  @db.Decimal(12, 2)
  feesDue       Decimal  @db.Decimal(12, 2)
  totalDue      Decimal  @db.Decimal(12, 2)
  principalPaid Decimal  @default(0) @db.Decimal(12, 2)
  interestPaid  Decimal  @default(0) @db.Decimal(12, 2)
  feesPaid      Decimal  @default(0) @db.Decimal(12, 2)
  status        String   @default("DUE")
  loan          Loan     @relation(fields: [loanId], references: [id], onDelete: Cascade)
  payments      Payment[]

  @@unique([loanId, installmentNo])
  @@index([dueDate, status])
}

model Payment {
  id          String        @id @default(cuid())
  loanId      String
  userId      String
  scheduleId  String?
  amount      Decimal       @db.Decimal(12, 2)
  paymentDate DateTime      @default(now())
  method      PaymentMethod
  referenceId String?
  status      PaymentStatus @default(PENDING)
  recordedBy  String
  createdAt   DateTime      @default(now())
  loan        Loan          @relation(fields: [loanId], references: [id], onDelete: Restrict)
  user        User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  schedule    RepaymentSchedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  recorder    User          @relation("PaymentRecorder", fields: [recordedBy], references: [id], onDelete: Restrict)

  @@index([loanId, status])
  @@index([paymentDate])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  action     String
  entityType String
  entityId   String
  metadata   Json?
  previousValue Json?
  newValue Json?
  ipAddress String?
  userAgent String?
  createdAt  DateTime @default(now())
  actor      User     @relation("AuditActor", fields: [actorId], references: [id])

  @@index([entityType, entityId])
  @@index([createdAt])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  entityId  String?
  type      String
  title     String
  message   String
  readAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@unique([userId, type, entityId])
}