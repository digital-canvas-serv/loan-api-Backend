# Database
DATABASE_URL="postgresql://user:password@localhost:5432/loan_management?schema=public"

# JWT Secret (min 32 characters)
JWT_SECRET="your-super-secret-jwt-key-at-least-32-characters-long"

# Server
PORT=4000
NODE_ENV=development

# CORS Origins (comma-separated)
# Production frontend
CORS_ORIGIN="https://loan-frontend-cyan.vercel.app,https://coloan.technlogs.app"

# Client URL (fallback for CORS_ORIGIN)
CLIENT_URL="http://localhost:5173"

# File Storage
FILE_STORAGE_PROVIDER=vercel-blob

# Vercel Blob Storage (required for vercel-blob provider)
# Get from Vercel Dashboard -> Storage -> Blob -> Settings -> Token
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxxxxxxx"